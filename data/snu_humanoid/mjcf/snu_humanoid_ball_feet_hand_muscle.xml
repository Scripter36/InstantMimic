<?xml version="1.0" ?>
<mujoco model="Human">
  <compiler angle="radian" inertiafromgeom="true" meshdir="assets"/>
  <option timestep="0.00833333333" integrator="implicitfast" cone="pyramidal"/>
  <default>
    <default class="joint_default">
      <joint armature="0.02" type="ball" damping="5"/>
    </default>
  </default>
  <include file="include/snu_humanoid_ball_feet_hand_assets.xml" />
  <worldbody>
    <geom name="floor" class="geom_floor" />
    <include file="include/snu_humanoid_ball_feet_hand_body.xml" />
  </worldbody>
  <size nuser_actuator="4" />
  <include file="include/muscles.xml"/>
</mujoco>
